# Copy to .env.local. Never commit keys. These values stay on the server.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
# Exact provider slug supporting the claim's temperature/top_p/max_tokens/seed.
OPENROUTER_PROVIDER=deepinfra/fp8
# Independent model for scripts/referee_dryrun.py; never served by the public proxy.
REFEREE_MODEL=openai/gpt-4.1-mini
# Keep disabled until the model and budget are approved and rehearsal passes.
TRIAL_ENABLED=false
# Each additional corpus has its own switch; leave previous routes disabled.
TRIAL_V2_ENABLED=false
TRIAL_V3_ENABLED=false
# Optional Vercel mode only after verifying DeepInfra has no configured BYOK key.
# Restricts the route to the model/provider above and the active window to 4 hours.
TRIAL_CREDIT_ONLY=false
# Approved total key credit limit in USD, no automatic reset; no default budget.
TRIAL_BUDGET_USD=5
# UTC timestamp, e.g. YYYY-MM-DDTHH:MM:SSZ; at most 4 hours in credit-only mode,
# otherwise at most 96 hours ahead.
TRIAL_EXPIRES_AT=
