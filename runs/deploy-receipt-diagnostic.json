             \"error_type\": type(error).__name__,\n                    \"error\": str(error)[:1200],\n                }, sort_keys=True)\n\n        self.report = gl.eq_principle.strict_eq(run)\n        return self.report\n\n    @gl.public.write\n    def check_llm(self) -> str:\n        def run():\n            try:\n                answer = gl.nondet.exec_prompt(\"Return only OK\")\n                return json.dumps({\"ok\": True, \"answer\": str(answer)[:400]}, sort_keys=True)\n            except Exception as error:\n                return json.dumps({\n                    \"ok\": False,\n                    \"error_type\": type(error).__name__,\n                    \"error\": str(error)[:1200],\n                }, sort_keys=True)\n\n        self.report = gl.eq_principle.strict_eq(run)\n        return self.report\n\n    @gl.public.view\n    def read(self) -> str:\n        return self.report\n","constructorArgs":{},"leaderOnly":false,"type":"deploy","contractAddress":"0xB878434fa39501E9c6785E9fCF8a2AFF501615c9"},"numOfInitialValidators":"3","statusName":"ACCEPTED","resultName":"AGREE","txExecutionResultName":"FINISHED_WITH_RETURN"}
